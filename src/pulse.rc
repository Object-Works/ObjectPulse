#include <winres.h>

#include "resource.h"
#include "version.h"

IDI_PULSE ICON "pulse.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION OP_VERSION_MAJOR, OP_VERSION_MINOR, OP_VERSION_PATCH, 0
 PRODUCTVERSION OP_VERSION_MAJOR, OP_VERSION_MINOR, OP_VERSION_PATCH, 0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041104B0"
        BEGIN
            VALUE "CompanyName", "Object Works"
            VALUE "FileDescription", "ObjectPulse status notch and taskbar for ObjectFrame"
            VALUE "FileVersion", OP_VERSION_STRING
            VALUE "InternalName", "ObjectPulse"
            VALUE "OriginalFilename", "ObjectPulse.exe"
            VALUE "ProductName", "ObjectPulse"
            VALUE "ProductVersion", OP_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x411, 1200
    END
END
